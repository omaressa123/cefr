{
  "expo": {
    "name": "CEFR Practice Partner",
    "slug": "cefr-practice-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100E1A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cefrpracticepartner.app"
    },
    "android": {
      "package": "com.cefrpracticepartner.app",
      "adaptiveIcon": {
        "backgroundColor": "#100E1A"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      "expo-asset"
    ]
  }
}
