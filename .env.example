# Required production secrets. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-database-password

# Optional deployment settings
MYSQL_DATABASE=cefr_practice_partner
MYSQL_USER=cefr
CORS_ORIGIN=http://localhost:8080
ALLOW_PUBLIC_TEACHER_REGISTRATION=false

# --- STT ---
# Local sidecar (scripts/whisper-server.py) or cloud Whisper endpoint
STT_BASE_URL=http://localhost:7860
STT_MODEL=whisper-verbatim-merged
