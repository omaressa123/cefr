# Required production secrets. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-database-password

# Optional deployment settings
MYSQL_DATABASE=cefr_practice_partner
MYSQL_USER=cefr
CORS_ORIGIN=http://localhost:8080
ALLOW_PUBLIC_TEACHER_REGISTRATION=false

# --- Local LLM (no API key needed) ---
# Point LLM_BASE_URL to your local OpenAI-compatible server
# e.g., http://localhost:11434/v1 (Ollama), http://localhost:8000/v1 (vLLM)
LLM_BASE_URL=
LLM_FAST_MODEL=gpt-oss-20b
LLM_HEAVY_MODEL=gpt-oss-120b

# --- STT ---
# Optional: point to local Whisper server
STT_BASE_URL=
STT_MODEL=whisper-large-v3-turbo

# --- Local Assessor (ACP) ---
# Set ASSESSOR_BACKEND=local to use local LLM instead of API keys
ASSESSOR_BACKEND=local
LOCAL_ASSESSOR_URL=http://localhost:11434/v1
LOCAL_ASSESSOR_MODEL=gpt-oss-20b
LOCAL_ASSESSOR_API_KEY=
