# --- Server ---
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# --- Database ---
# When running via docker-compose this is overridden automatically.
DATABASE_URL=mysql://cefr:cefr_local_password@localhost:3306/cefr_practice_partner

# --- Primary LLM (conversational reply + grammar assessor) ---
# Any OpenAI-compatible /chat/completions endpoint. Groq is a drop-in fit
# for the original spec (gpt-oss-20b / gpt-oss-120b).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_FAST_MODEL=gpt-oss-20b
LLM_HEAVY_MODEL=gpt-oss-120b

# --- Fallback LLM (optional) ---
# Google now exposes an OpenAI-compatible endpoint that fits here too.
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-flash-latest

# --- Speech-to-text ---
# Any OpenAI-compatible /audio/transcriptions endpoint.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# --- Text-to-speech ---
# No key needed - uses free Microsoft Edge voices via msedge-tts.
TTS_VOICE=en-US-AriaNeural

# --- Local Assessor (ACP) ---
ASSESSOR_BACKEND=local
LOCAL_ASSESSOR_URL=http://localhost:11434/v1
LOCAL_ASSESSOR_MODEL=gpt-oss-20b
LOCAL_ASSESSOR_API_KEY=
